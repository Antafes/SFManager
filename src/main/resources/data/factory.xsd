<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.w3schools.com/SFManager/factory" targetNamespace="http://www.w3schools.com/SFManager/factory">
    <xs:element name="factory">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string" />
                <xs:element name="useStorage" type="xs:boolean" minOccurs="0" />
                <xs:element name="productions">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="production" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>
</xs:schema>
