<xs:schema
    elementFormDefault="qualified"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://www.w3schools.com/SFManager/plans"
    targetNamespace="http://www.w3schools.com/SFManager/plans"
>
    <xs:complexType name="ChoiceList">
        <xs:sequence>
            <xs:element name="choice" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="itemKey" type="xs:string" />
                        <xs:element name="recipeKey" type="xs:string" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="plans">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="factoryId" type="xs:string" />
                <xs:element name="plan" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="xs:string" />
                            <xs:element name="name" type="xs:string" />
                            <xs:element name="targetItemKey" type="xs:string" />
                            <xs:element name="targetRate" type="xs:double" />
                            <xs:element name="recipeChoices" type="ChoiceList" />
                            <xs:element name="sideRecipeChoices" type="ChoiceList" />
                            <xs:element name="stepSettings">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="step" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="itemKey" type="xs:string" />
                                                    <xs:element name="clockSpeed" type="xs:double" />
                                                    <xs:element name="somersloops" type="xs:int" />
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
