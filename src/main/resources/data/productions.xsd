<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.w3schools.com/SFManager/items" targetNamespace="http://www.w3schools.com/SFManager/items">
    <xs:element name="productions">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="production" type="production" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="production">
        <xs:sequence>
            <xs:element name="selectedBuilding" type="xs:string" />
            <xs:element name="selectedRecipe" type="xs:string" minOccurs="0" />
            <xs:element name="selectedItem" type="xs:string" minOccurs="0" />
            <xs:element name="materialSources" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="materialSource" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:attribute name="itemKey" type="xs:string" use="required" />
                                <xs:attribute name="group" type="xs:string" use="required" />
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="group" type="xs:string" minOccurs="0" />
            <xs:element name="position" type="xs:string" minOccurs="0" />
            <xs:element name="amount" type="xs:double" minOccurs="0" />
            <xs:element name="purity" type="xs:string" minOccurs="0" />
            <xs:element name="pressurizerId" type="xs:string" minOccurs="0" />
            <xs:element name="clockSpeed" type="xs:double" minOccurs="0" />
            <xs:element name="usedSomersloops" type="xs:integer" minOccurs="0" />
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>
</xs:schema>
