<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="http://www.w3schools.com/SFManager/resource-nodes" targetNamespace="http://www.w3schools.com/SFManager/resource-nodes">
    <xs:element name="resourceNodes">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="resourceNode" type="r:resourceNode" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="resourceNode">
        <xs:sequence>
            <xs:element name="type" type="r:type" />
            <xs:element name="item" type="xs:string" minOccurs="0" />
            <xs:element name="purity" type="r:purity" minOccurs="0" />
            <xs:element name="position" type="r:position" />
            <xs:element name="core" type="xs:string" minOccurs="0" />
        </xs:sequence>
        <xs:attribute name="key" type="xs:string" use="required" />
    </xs:complexType>
    <xs:simpleType name="type">
        <xs:restriction base="xs:string">
            <xs:enumeration value="node" />
            <xs:enumeration value="well" />
            <xs:enumeration value="geyser" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="purity">
        <xs:restriction base="xs:string">
            <xs:enumeration value="impure" />
            <xs:enumeration value="normal" />
            <xs:enumeration value="pure" />
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="position">
        <xs:sequence>
            <xs:element name="x" type="xs:double" />
            <xs:element name="y" type="xs:double" />
            <xs:element name="z" type="xs:double" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>
